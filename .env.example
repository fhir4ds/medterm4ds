# medterm4ds environment configuration
# Copy to .env and fill in your values

# Required for auto-download from Hugging Face (if repo is private)
HF_TOKEN=your_hf_token_here

# Required for UMLS lookups (obtain from https://uts.nlm.nih.gov)
UMLS_API_KEY=your_umls_api_key
NCBI_API_KEY=your_ncbi_api_key

# Optional: override artifact locations (defaults to ~/.cache/medterm4ds/)
# MEDTERM4DS_CACHE_DIR=/path/to/cached/artifacts
# MEDTERM4DS_EMBEDDING_MODEL_DIR=/path/to/sapbert/model
# MEDTERM4DS_SEARCH_INDEX_DIR=/path/to/bm25/indexes

# Optional: override individual canonical paths
# MEDTERM4DS_CANONICAL_PATH=/path/to/canonical_anchor_value_sets.json
# MEDTERM4DS_CANONICAL_INDEX=/path/to/canonical_concepts_faiss.index
# MEDTERM4DS_CANONICAL_META=/path/to/canonical_concepts_metadata.json

# Optional: override UMLS DuckDB location
# MEDTERM4DS_UMLS_DB=/path/to/umls.duckdb

# Optional: override HF repo (for private forks)
# MEDTERM4DS_HF_REPO_ID=fhir4ds/medterm4ds
# MEDTERM4DS_HF_REVISION=v0.0.1
