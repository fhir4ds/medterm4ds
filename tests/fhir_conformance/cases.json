{
  "description": "FHIR R4 terminology server conformance test cases",
  "version": "1.0",
  "cases": [
    {"id": "metadata", "description": "CapabilityStatement is valid R4", "method": "GET", "path": "/fhir/metadata", "params": {}, "expected_status": 200, "expected_resource_type": "CapabilityStatement", "expected_fields": [{"path": "fhirVersion", "equals": "4.0.1"}]},
    {"id": "metadata-ops-advertised", "description": "All 7 operations in CapabilityStatement", "method": "GET", "path": "/fhir/metadata", "params": {}, "expected_status": 200, "custom_check": "all_operations_advertised"},

    {"id": "lookup-snomed-valid", "description": "Lookup known SNOMED code", "method": "GET", "path": "/fhir/CodeSystem/$lookup", "params": {"system": "http://snomed.info/sct", "code": "44054006"}, "expected_status": 200, "expected_resource_type": "Parameters", "expected_fields": [{"path": "parameter[?name=='display'].valueString", "contains": "diabetes"}, {"path": "parameter[?name=='system'].valueUri", "equals": "http://snomed.info/sct"}, {"path": "parameter[?name=='code'].valueCode", "equals": "44054006"}]},
    {"id": "lookup-snomed-parent", "description": "Lookup SNOMED Diabetes code", "method": "GET", "path": "/fhir/CodeSystem/$lookup", "params": {"system": "http://snomed.info/sct", "code": "73211009"}, "expected_status": 200, "expected_resource_type": "Parameters", "expected_fields": [{"path": "parameter[?name=='display'].valueString", "contains": "iabetes"}]},
    {"id": "lookup-rxnorm-valid", "description": "Lookup RxNorm metformin", "method": "GET", "path": "/fhir/CodeSystem/$lookup", "params": {"system": "http://www.nlm.nih.gov/research/umls/rxnorm", "code": "860975"}, "expected_status": 200, "expected_resource_type": "Parameters", "expected_fields": [{"path": "parameter[?name=='display'].valueString", "contains": "metformin"}]},
    {"id": "lookup-invalid-code", "description": "Lookup nonexistent code returns OperationOutcome", "method": "GET", "path": "/fhir/CodeSystem/$lookup", "params": {"system": "http://snomed.info/sct", "code": "NONEXISTENT999"}, "expected_status": 200, "expected_resource_type": "OperationOutcome"},
    {"id": "lookup-unknown-system", "description": "Lookup with fake system returns 400", "method": "GET", "path": "/fhir/CodeSystem/$lookup", "params": {"system": "http://fake.example/sys", "code": "123"}, "expected_status": 400, "expected_resource_type": "OperationOutcome"},
    {"id": "lookup-post-body", "description": "POST $lookup with Parameters body", "method": "POST", "path": "/fhir/CodeSystem/$lookup", "body": {"resourceType": "Parameters", "parameter": [{"name": "system", "valueUri": "http://snomed.info/sct"}, {"name": "code", "valueCode": "44054006"}]}, "expected_status": 200, "expected_resource_type": "Parameters"},

    {"id": "validate-valid", "description": "Validate known code returns true", "method": "GET", "path": "/fhir/CodeSystem/$validate-code", "params": {"system": "http://snomed.info/sct", "code": "44054006"}, "expected_status": 200, "expected_resource_type": "Parameters", "expected_fields": [{"path": "parameter[?name=='result'].valueBoolean", "equals": true}]},
    {"id": "validate-invalid", "description": "Validate unknown code returns false", "method": "GET", "path": "/fhir/CodeSystem/$validate-code", "params": {"system": "http://snomed.info/sct", "code": "FAKE888"}, "expected_status": 200, "expected_resource_type": "Parameters", "expected_fields": [{"path": "parameter[?name=='result'].valueBoolean", "equals": false}]},
    {"id": "validate-unknown-system", "description": "Validate with fake system returns 400", "method": "GET", "path": "/fhir/CodeSystem/$validate-code", "params": {"system": "http://fake.example/sys", "code": "123"}, "expected_status": 400},
    {"id": "validate-icd10-valid", "description": "Validate ICD-10 code", "method": "GET", "path": "/fhir/CodeSystem/$validate-code", "params": {"system": "http://hl7.org/fhir/sid/icd-10-cm", "code": "E11"}, "expected_status": 200, "expected_fields": [{"path": "parameter[?name=='result'].valueBoolean", "equals": true}]},

    {"id": "translate-snomed-to-icd10", "description": "Translate SNOMED to ICD-10", "method": "GET", "path": "/fhir/ConceptMap/$translate", "params": {"system": "http://snomed.info/sct", "code": "44054006", "targetsystem": "http://hl7.org/fhir/sid/icd-10-cm"}, "expected_status": 200, "expected_resource_type": "Parameters", "expected_fields": [{"path": "parameter[?name=='result'].valueBoolean", "equals": true}]},
    {"id": "translate-no-target", "description": "Translate with all targets", "method": "GET", "path": "/fhir/ConceptMap/$translate", "params": {"system": "http://snomed.info/sct", "code": "44054006"}, "expected_status": 200},
    {"id": "translate-unknown-system", "description": "Translate with fake system returns 400", "method": "GET", "path": "/fhir/ConceptMap/$translate", "params": {"system": "http://fake.example/sys", "code": "123"}, "expected_status": 400},

    {"id": "subsumes-parent-child", "description": "Parent subsumes child", "method": "GET", "path": "/fhir/CodeSystem/$subsumes", "params": {"system": "http://snomed.info/sct", "codeA": "73211009", "codeB": "44054006"}, "expected_status": 200, "expected_resource_type": "Parameters", "expected_fields": [{"path": "parameter[?name=='outcome'].valueCode", "equals": "subsumes"}]},
    {"id": "subsumes-child-parent", "description": "Child subsumed by parent", "method": "GET", "path": "/fhir/CodeSystem/$subsumes", "params": {"system": "http://snomed.info/sct", "codeA": "44054006", "codeB": "73211009"}, "expected_status": 200, "expected_fields": [{"path": "parameter[?name=='outcome'].valueCode", "equals": "subsumed-by"}]},
    {"id": "subsumes-identical", "description": "Identical codes are equivalent", "method": "GET", "path": "/fhir/CodeSystem/$subsumes", "params": {"system": "http://snomed.info/sct", "codeA": "44054006", "codeB": "44054006"}, "expected_status": 200, "expected_fields": [{"path": "parameter[?name=='outcome'].valueCode", "equals": "equivalent"}]},
    {"id": "subsumes-unrelated", "description": "Unrelated codes are not-subsumed", "method": "GET", "path": "/fhir/CodeSystem/$subsumes", "params": {"system": "http://snomed.info/sct", "codeA": "44054006", "codeB": "860975"}, "expected_status": 200, "expected_fields": [{"path": "parameter[?name=='outcome'].valueCode", "equals": "not-subsumed"}]},
    {"id": "subsumes-unknown-system", "description": "Subsumes with fake system returns 400", "method": "GET", "path": "/fhir/CodeSystem/$subsumes", "params": {"system": "http://fake.example/sys", "codeA": "1", "codeB": "2"}, "expected_status": 400},

    {"id": "expand-filter", "description": "Expand with text filter", "method": "GET", "path": "/fhir/ValueSet/$expand", "params": {"filter": "diabetes", "count": 10}, "expected_status": 200, "expected_resource_type": "ValueSet", "expected_fields": [{"path": "expansion.total", "gte": 1}]},
    {"id": "expand-filter-metformin", "description": "Expand filter for metformin", "method": "GET", "path": "/fhir/ValueSet/$expand", "params": {"filter": "metformin", "count": 5}, "expected_status": 200, "expected_resource_type": "ValueSet", "expected_fields": [{"path": "expansion.total", "gte": 1}]},
    {"id": "expand-filter-no-results", "description": "Expand filter with no matches", "method": "GET", "path": "/fhir/ValueSet/$expand", "params": {"filter": "zzzznomatch", "count": 5}, "expected_status": 200, "expected_fields": [{"path": "expansion.total", "equals": 0}]},
    {"id": "expand-no-filter-400", "description": "Expand without filter returns 400", "method": "GET", "path": "/fhir/ValueSet/$expand", "params": {}, "expected_status": 400},
    {"id": "expand-intensional-isa", "description": "Intensional is-a expansion", "method": "POST", "path": "/fhir/ValueSet/$expand", "body": {"resourceType": "ValueSet", "compose": {"include": [{"system": "http://snomed.info/sct", "filter": [{"property": "concept", "op": "is-a", "value": "73211009"}]}]}}, "expected_status": 200, "expected_resource_type": "ValueSet", "custom_check": "expansion_contains_codes", "expected_codes": ["73211009", "44054006"]},
    {"id": "expand-intensional-descendant-of", "description": "Intensional descendant-of expansion (no root)", "method": "POST", "path": "/fhir/ValueSet/$expand", "body": {"resourceType": "ValueSet", "compose": {"include": [{"system": "http://snomed.info/sct", "filter": [{"property": "concept", "op": "descendant-of", "value": "73211009"}]}]}}, "expected_status": 200, "expected_resource_type": "ValueSet", "custom_check": "expansion_contains_codes", "expected_codes": ["44054006"]},
    {"id": "expand-explicit", "description": "Explicit concept list expansion", "method": "POST", "path": "/fhir/ValueSet/$expand", "body": {"resourceType": "ValueSet", "compose": {"include": [{"system": "http://snomed.info/sct", "concept": [{"code": "44054006", "display": "T2DM"}, {"code": "73211009", "display": "Diabetes"}]}]}}, "expected_status": 200, "expected_resource_type": "ValueSet", "custom_check": "expansion_contains_codes", "expected_codes": ["44054006", "73211009"]},
    {"id": "expand-fhir-vs-url", "description": "SNOMED fhir_vs URL pattern", "method": "GET", "path": "/fhir/ValueSet/$expand", "params": {"url": "http://snomed.info/sct/73211009?fhir_vs=isa", "count": 100}, "expected_status": 200, "expected_resource_type": "ValueSet", "custom_check": "expansion_contains_codes", "expected_codes": ["73211009", "44054006"]},

    {"id": "closure-init", "description": "Initialize empty closure", "method": "POST", "path": "/fhir/CodeSystem/$closure", "body": {"resourceType": "Parameters", "parameter": [{"name": "name", "valueString": "conf-init"}]}, "expected_status": 200, "expected_resource_type": "Parameters", "expected_fields": [{"path": "parameter[?name=='return'].valueString", "present": true}]},
    {"id": "closure-missing-name", "description": "Closure without name returns 400", "method": "POST", "path": "/fhir/CodeSystem/$closure", "body": {"resourceType": "Parameters", "parameter": []}, "expected_status": 400},
    {"id": "closure-add-concepts", "description": "Add concepts to closure", "method": "POST", "path": "/fhir/CodeSystem/$closure", "body": {"resourceType": "Parameters", "parameter": [{"name": "name", "valueString": "conf-add"}, {"name": "concept", "valueCoding": {"system": "http://snomed.info/sct", "code": "73211009", "display": "Diabetes"}}, {"name": "concept", "valueCoding": {"system": "http://snomed.info/sct", "code": "44054006", "display": "Type 2 diabetes"}}]}, "expected_status": 200, "expected_resource_type": "Parameters", "custom_check": "closure_subsumes", "closure_name": "conf-add", "code_a": "73211009", "code_b": "44054006", "expected_outcome": "subsumes"},

    {"id": "search-lexical-no-index", "description": "Search without BM25 index returns 503", "method": "GET", "path": "/fhir/CodeSystem/$search", "params": {"query": "diabetes"}, "expected_status": 503, "expected_resource_type": "OperationOutcome"},
    {"id": "search-hybrid-no-index", "description": "Hybrid search without indexes returns 503", "method": "GET", "path": "/fhir/CodeSystem/$search", "params": {"query": "diabetes", "searchMode": "hybrid"}, "expected_status": 503, "expected_resource_type": "OperationOutcome"},
    {"id": "search-semantic-no-model", "description": "Semantic search without model returns 503 (or results if model available)", "method": "GET", "path": "/fhir/CodeSystem/$search", "params": {"query": "diabetes", "searchMode": "semantic"}, "expected_status": 200, "expected_resource_type": "Bundle", "skip_if_model_available": true, "note": "When model is absent, returns 503. When present, returns Bundle. Either is correct."}
  ]
}
