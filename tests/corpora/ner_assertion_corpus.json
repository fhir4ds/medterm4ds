{
  "_comment": "Assertion/status edge cases. Targets negation scope, pseudonegation, discontinuation, social/allergy context, and radiology boilerplate. Cases with include_non_affirmed=true expect a specific status; 'noise' entries must not resolve.",
  "cases": [
    {
      "id": "assert-01",
      "family": "neg_list",
      "include_non_affirmed": true,
      "text": "No fever, cough, or dyspnea.",
      "mentions": [
        {
          "text": "fever",
          "expect": [
            "fever"
          ],
          "status": "negated"
        },
        {
          "text": "cough",
          "expect": [
            "cough"
          ],
          "status": "negated"
        },
        {
          "text": "dyspnea",
          "expect": [
            "dyspnea",
            "breathlessness",
            "shortness of breath"
          ],
          "status": "negated"
        }
      ]
    },
    {
      "id": "assert-02",
